# Round robin sends transfers to both backend service rates.
run 6s {
    seed 2333
    speed 0
}
defaults {
    link 100MB
    travel 1ms
    queue 128
}
tcp {
    congestion newreno
    mss 1460B
    SACK true
    ECN false
}

balancer lb {
    algo rr
    ingress 100MB
    egress 100MB
}

backend api-0 {
    name "Slow backend"
    link 1MB
}

backend api-1 {
    name "Fast backend"
    link 100MB
}

clients regular {
    count 12
    payload 100KB
    every 50ms
    link 100MB
}
