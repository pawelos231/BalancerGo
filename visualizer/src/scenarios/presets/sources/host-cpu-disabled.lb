# Bypass host CPU work to establish the network baseline.
language 1
run 180s seed 1 speed 1 snapshots 100ms max-events 5000000000

defaults {
    link 1.25GB travel 10us queue 4096 loss 0%
    queue-policy default ecn-threshold 0% signal-probability 0%
    payload 1073741824B packets 10000 segment-gap 0ns
}

tcp {
    congestion newreno mss 1460B receive-buffer 65535B
    SACK true
    ECN false
    client-idle 0ns backend-half-open-idle 0ns backend-established-idle 0ns
    congestion-control {
        fast-retransmit true fast-convergence true
        initial-window 4 maximum-window 0 ssthresh 65535B
    }
    rto { mode adaptive backoff true initial 1s minimum 200ms maximum 60s }
    close { msl 30s fin-wait 60s fin-retries 5 }
    delayed-ack { enabled false segments 2 max-delay 40ms }
}

balancer lb {
    algo rr
    ingress {
        link 1.25GB travel 0ns queue 4096 loss 0%
        queue-policy default ecn-threshold 0% signal-probability 0%
    }
    egress 1.25GB
    host { cores 1 packet-time 0ns queue 1024 }
    mapping-timeouts { half-open 5s established 50s closing 120s reset 10s }
}

backend backend-1 {
    name "Backend 1"
    address "10.0.0.1"
    host { cores 1 packet-time 0ns queue 1024 }
}

backend backend-2 {
    name "Backend 2"
    address "10.0.0.2"
    host { cores 1 packet-time 0ns queue 1024 }
}

clients clients {
    count 64 start 0ns every 0ns
}
