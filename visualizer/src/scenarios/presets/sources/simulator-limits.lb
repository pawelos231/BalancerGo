language 1
# 50,000 clients and 100 backends stress the simulator for one virtual millisecond.
# Link units are decimal bytes/s; 125MB is 1 Gbit/s.
run 1ms seed 1 speed 0 snapshots 100ms max-events 20000000

defaults {
    link 10TB
    travel 0ns
    queue 4096
    loss 0%
    queue-policy default
    ecn-threshold 0%
    signal-probability 0%
    packets 10000
    payload 1073741824B # 1 GiB per client.
    segment-gap 0ns
}

tcp {
    mss 1024B
    congestion reno
    receive-buffer 65535B
    sack false
    ecn false
    congestion-control {
        fast-retransmit true
        fast-convergence true
        initial-window 4
        maximum-window 0
        ssthresh 65535B
    }
    rto { mode adaptive backoff true initial 1s minimum 200ms maximum 60s }
    close { msl 30s fin-wait 60s fin-retries 5 }
    delayed-ack { enabled false segments 2 max-delay 40ms }
    client-idle 20s
    backend-half-open-idle 5s
    backend-established-idle 0ns
}

# 10 PB/s becomes exactly 80000000000000000 bit/s in compiled JSON.
profile limits-backend { link 100TB }

balancer lb {
    algo rr
    ingress {
        link 10PB
        travel 0ns
        queue 131072
        loss 0%
        queue-policy default
        ecn-threshold 0%
        signal-probability 0%
    }
    egress 10PB
    host { cores 1 packet-time 0ns queue 1024 }
    mapping-timeouts { half-open 5s established 50s closing 120s reset 10s }
}

# Explicit addresses preserve numeric backend order across all 100 endpoints.

backend backend-1 use limits-backend {
    name "Backend 1"
    address "10.0.0.1"
}

backend backend-2 use limits-backend {
    name "Backend 2"
    address "10.0.0.2"
}

