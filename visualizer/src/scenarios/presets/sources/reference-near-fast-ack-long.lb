# Reference: near backend, fast ACK path, long transfers.
# Backend 1 remains the common near, full-rate comparison path.
language 1
run 60s seed 1 speed 1 snapshots 100ms max-events 50000000

defaults {
    link 125MB travel 1ms queue 1024 loss 0%
    queue-policy default ecn-threshold 0% signal-probability 0%
    payload 1048576B packets 10000 segment-gap 0ns
}

tcp {
    congestion reno mss 1024B receive-buffer 65535B
    sack false ecn false
    client-idle 20s backend-half-open-idle 5s backend-established-idle 0ns
    congestion-control {
        fast-retransmit true fast-convergence true
        initial-window 4 maximum-window 0 ssthresh 65535B
    }
    rto { mode adaptive backoff true initial 1s minimum 200ms maximum 60s }
    close { msl 30s fin-wait 60s fin-retries 5 }
    delayed-ack { enabled false segments 2 max-delay 40ms }
}

balancer lb {
    algo rr
    ingress {
        link 125MB travel 0ns queue 1024 loss 0%
        queue-policy default ecn-threshold 0% signal-probability 0%
    }
    egress 125MB
    host { cores 1 packet-time 0ns queue 1024 }
    mapping-timeouts { half-open 5s established 50s closing 120s reset 10s }
}

backend backend-1 {
    name "Backend 1"
    address "10.0.0.1"
}

backend backend-2 {
    name "Backend 2"
    address "10.0.0.2"
    to-lb { link 125MB travel 1ms }
    from-lb { travel 1ms }
}

clients clients {
    count 16 start 0ns every 0ns
}
