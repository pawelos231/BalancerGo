# Begin with fixed CPU time, then declare uniform CPU time at one second.
# The timeline declaration is checked, but cannot be applied or run yet.
# Clients arrive before and after the change, through 1.2s.
language 1

run 2s {
    seed 1
    speed 0
    snapshots 100ms
    max-events 100000
}

defaults {
    link 10MB
    travel 1ms
    queue 32
}

tcp {
    congestion reno
    mss 1460B
    SACK false
    ECN false
}

balancer lb {
    algo rr
    ingress 10MB
    egress 10MB
}

backend api-0 {
    address "10.0.0.1"
    host {
        cores 1
        packet-time 5us
        queue 32
    }
}

clients regular {
    count 4
    start 0ns
    every 400ms
    payload 16KB
}

at 1s {
    set backend api-0 {
        host {
            packet-time uniform {
                min 5us
                max 15us
            }
        }
    }
}
