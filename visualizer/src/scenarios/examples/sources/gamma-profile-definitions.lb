language 1
run 2s speed 0

# Named definitions are unbound; the topology below keeps scalar settings.
# A gamma density with shape 2 and scale 1ms.
distribution two-stage-time gamma {
    shape 2
    scale 1ms
    min 0ms
    max 10ms
}

# A valid shape below 1, with an integrable peak at zero.
distribution near-zero-time gamma {
    shape 0.5
    scale 2ms
    min 0ms
    max 10ms
}

balancer lb {}
backend api-0 {}
clients regular {
    count 2
    payload 8KB
    every 10ms
}
