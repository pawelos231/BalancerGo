language 1
run 2s speed 0

# Named definitions are unbound; the topology below keeps scalar settings.
# A decreasing density on 0ms through 20ms.
distribution short-delays exponential {
    mean 5ms
    min 0ms
    max 20ms
}

# The exponential tail conditioned to lie in a later interval.
distribution tail-delays exponential {
    mean 5ms
    min 10ms
    max 30ms
}

balancer lb {}
backend api-0 {}
clients regular {
    count 2
    payload 8KB
    every 10ms
}
