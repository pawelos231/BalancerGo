# Intentionally invalid: uniform requires both min and max.
# The diagnostic points to the family name when max is missing.
language 1

run 2s {
    seed 1
    speed 0
    snapshots 100ms
    max-events 100000
}

defaults {
    link 10MB
    travel 1ms
    queue 32
}

tcp {
    congestion reno
    mss 1460B
    SACK false
    ECN false
}

balancer lb {
    algo rr
    ingress 10MB
    egress 10MB
}

backend api-0 {
    address "10.0.0.1"
    host {
        cores 1
        packet-time uniform {
            min 5us
        }
        queue 32
    }
}

clients regular {
    count 2
    start 0ns
    every 100ms
    payload 16KB
}
