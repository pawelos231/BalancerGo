language 1
run 2s speed 0

# Named definitions are unbound; the topology below keeps scalar settings.
# A Pareto density retained from its 1ms threshold through 10ms.
distribution tail-time pareto {
    scale 1ms
    shape 2
    min 1ms
    max 10ms
}

# A heavier tail, retaining values above twice the scale.
distribution later-tail-time pareto {
    scale 1ms
    shape 1
    min 2ms
    max 20ms
}

balancer lb {}
backend api-0 {}
clients regular {
    count 2
    payload 8KB
    every 10ms
}
