language 1
run 2s speed 0

# Named definitions are unbound; the topology below keeps scalar settings.
# A moderately skewed density with median 5ms before truncation.
distribution moderate-tail-time lognormal {
    median 5ms
    log-stddev 0.5
    min 0ms
    max 20ms
}

# A wider right tail produced by larger log-stddev.
distribution long-tail-time lognormal {
    median 5ms
    log-stddev 1
    min 0ms
    max 40ms
}

balancer lb {}
backend api-0 {}
clients regular {
    count 2
    payload 8KB
    every 10ms
}
